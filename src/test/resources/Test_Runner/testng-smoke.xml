<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite">

    <test name="Smoke Tests" preserve-order="true">

        <groups>
            <run>
                <include name="Smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.swaglabs.tests.TestLogin"/>
            <class name="com.swaglabs.tests.TestInventory"/>
            <class name="com.swaglabs.tests.TestCart"/>
            <class name="com.swaglabs.tests.TestCheckoutYourInformation"/>
            <class name="com.swaglabs.tests.TestCheckoutOverview"/>
            <class name="com.swaglabs.tests.TestCheckoutComplete"/>
        </classes>

    </test>

</suite>