<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Swag Labs Automation">

    <!--
        REPORTER: Generates the HTML dashboard after all tests finish.
        No other configuration needed — it reads the template from
        src/main/resources/report-template.html automatically.
    -->
    <listeners>
        <listener class-name="com.swaglabs.report.DashboardReporter"/>
<!--        <listener class-name="com.swaglabs.utils.TestListener"/>-->
        <listener class-name="com.aventstack.chaintest.plugins.ChainTestListener"></listener>
    </listeners>

<!--    &lt;!&ndash; Optional: override defaults via parameters &ndash;&gt;-->
<!--    <parameter name="env" value="Production"/>-->
<!--    <parameter name="branch" value="Master"/>-->

    <test name="Login Test">
        <classes>
            <class name="com.swaglabs.tests.TestLogin"/>
        </classes>
    </test>

    <test name="Inventory Tests">
        <classes>
            <class name="com.swaglabs.tests.TestInventory"/>
        </classes>
    </test>

    <test name="Cart Test">
        <classes>
            <class name="com.swaglabs.tests.TestCart"/>
        </classes>
    </test>

    <test name="Checkout Your Information Test">
        <classes>
            <class name="com.swaglabs.tests.TestCheckoutYourInformation"/>
        </classes>
    </test>

    <test name="Checkout Overview Test">
        <classes>
            <class name="com.swaglabs.tests.TestCheckoutOverview"/>
        </classes>
    </test>

    <test name="Checkout Complete Test">
        <classes>
            <class name="com.swaglabs.tests.TestCheckoutComplete"/>
        </classes>
    </test>
</suite>
